<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9FB"
    tools:context=".AdminHomeActivity">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">


            <TextView
                android:id="@+id/tvWelcomeAdmin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hoş geldin Admin"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#58567A"
                android:layout_marginBottom="20dp"/>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="28dp">


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="87dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="#A3C4F3"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvQuestionCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="13434"
                        android:textColor="#555879"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Soru sayısı"
                        android:textColor="#000000"
                        android:textSize="14sp" />
                </LinearLayout>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="87dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="#A3C4F3"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvExamCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="147"
                        android:textColor="#555879"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sınav sayısı"
                        android:textColor="#000000"
                        android:textSize="14sp" />
                </LinearLayout>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="87dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="#A3C4F3"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvUserCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="289"
                        android:textColor="#555879"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="116dp"
                        android:layout_height="wrap_content"
                        android:text="Kullanıcı sayısı"
                        android:textColor="#000000"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExamManage"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Sınav ekle/sil"
                        android:textAllCaps="false"
                        android:textColor="#555879"
                        android:textSize="16sp"
                        app:cornerRadius="8dp"
                        app:backgroundTint="#C9C6FF"
                        app:icon="@drawable/ic_exam"
                        app:iconTint="#555879"
                        app:iconGravity="start"
                        app:iconPadding="12dp"/>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="#555879"/>
                </FrameLayout>


                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQuestionManage"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Soru ekle/sil"
                        android:textAllCaps="false"
                        android:textColor="#555879"
                        android:textSize="16sp"
                        app:cornerRadius="8dp"
                        app:backgroundTint="#C9C6FF"
                        app:icon="@drawable/ic_question"
                        app:iconTint="#555879"
                        app:iconGravity="start"
                        app:iconPadding="12dp"/>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="#555879"/>
                </FrameLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCategoryManage"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Kategori ekle/sil"
                        android:textAllCaps="false"
                        android:textColor="#555879"
                        android:textSize="16sp"
                        app:cornerRadius="8dp"
                        app:backgroundTint="#C9C6FF"
                        app:icon="@drawable/ic_category"
                        app:iconTint="#555879"
                        app:iconGravity="start"
                        app:iconPadding="12dp"/>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="#555879"/>
                </FrameLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUserManage"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Kullanıcıları yönet"
                        android:textAllCaps="false"
                        android:textColor="#555879"
                        android:textSize="16sp"
                        app:cornerRadius="8dp"
                        app:backgroundTint="#C9C6FF"
                        app:icon="@drawable/ic_users"
                        app:iconTint="#555879"
                        app:iconGravity="start"
                        app:iconPadding="12dp"/>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="#555879"/>
                </FrameLayout>


                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFeedbackManage"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Geri bildirimleri yönet"
                        android:textAllCaps="false"
                        android:textColor="#555879"
                        android:textSize="16sp"
                        app:cornerRadius="8dp"
                        app:backgroundTint="#C9C6FF"
                        app:icon="@drawable/ic_feedback_24"
                        app:iconTint="#555879"
                        app:iconGravity="start"
                        app:iconPadding="12dp"/>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="#555879"/>
                </FrameLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnProfile"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Profil görüntüle"
                        android:textAllCaps="false"
                        android:textColor="#555879"
                        android:textSize="16sp"
                        app:cornerRadius="8dp"
                        app:backgroundTint="#C9C6FF"
                        app:icon="@drawable/ic_person"
                    app:iconTint="#555879"
                    app:iconGravity="start"
                    app:iconPadding="12dp"/>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="#555879"/>
                </FrameLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
